{
  "name": "sistema-integral-convivencia-escolar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild server/api/index.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "build:web": "vite build",
    "start": "node dist/server.cjs",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('server.js',{force:true})\"",
    "lint": "npm run lint:code && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"server/**/*.test.ts\"",
    "ci": "npm run lint && npm run test && npm run build:web && npm run security-audit",
    "prepare": "husky",
    "lint:types": "tsc --noEmit",
    "lint:code": "eslint .",
    "lint:code:fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run lint:code && npm run test && npm run build:web",
    "test:coverage": "node --experimental-test-coverage --import tsx --test \"src/**/*.test.ts\" \"server/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip": "knip",
    "security-audit": "npm audit --omit=dev",
    "security:secrets": "npx gitleaks detect --source . --verbose",
    "pre-push": "npm run lint && npm run test && npm run build:web && npm run security-audit"
  },
  "knip": {
    "ignore": [
      "server/api/index.ts"
    ]
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-dialog": "^1.1.19",
    "@sentry/browser": "^10.66.0",
    "@sentry/react": "^10.66.0",
    "@supabase/supabase-js": "^2.110.3",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "pdfjs-dist": "^6.1.200",
    "posthog-js": "^1.404.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-to-print": "^3.3.0",
    "web-vitals": "^5.3.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.3"
  }
}
