{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {}
  },
  "model": "opencode/glm-5.2",
  "small_model": "opencode/gpt-5.4-mini",
  "instructions": ["AGENTS.md", "README.md"],

  "mcp": {
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "codebase-memory": {
      "type": "local",
      "command": ["npx", "-y", "codebase-memory-mcp"],
      "enabled": true
    },
    "supabase": {
      "type": "local",
      "command": ["npx", "-y", "@supabase/mcp-server-supabase@latest"],
      "env": {
        "SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}",
        "SUPABASE_URL": "https://jjzwwhnofiepvliugowr.supabase.co"
      },
      "enabled": true,
      "description": "Acceso directo a Supabase para consultas, migraciones y administracion de la base de datos"
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "description": "Documentacion actualizada de librerias (React, Tailwind, Supabase, etc.)"
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/Users/heae2/sistema-integral-convivencia-escolar"
      ],
      "enabled": true,
      "description": "Acceso directo al sistema de archivos del proyecto"
    },
    "git": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@anthropic/mcp-server-git",
        "--repository",
        "C:/Users/heae2/sistema-integral-convivencia-escolar"
      ],
      "enabled": false,
      "description": "Operaciones Git (deshabilitado - usar bash o GitHub MCP)"
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "enabled": true,
      "description": "GitHub API: issues, PRs, repos, code search"
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
      "description": "Navegacion web y testing E2E con Playwright"
    }
  },

  "lsp": {
    "typescript": {
      "command": ["node_modules/.bin/typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx"],
      "initialization": {
        "diagnostics": true,
        "completions": true,
        "documentFormatting": false,
        "references": true,
        "definition": true,
        "implementation": true,
        "referencesCodeLens": true,
        "declarationsCodeLens": true
      }
    },
    "tailwindcss": {
      "command": ["node_modules/.bin/tailwindcss-language-server", "--stdio"],
      "extensions": [".tsx", ".css"],
      "initialization": {
        "diagnostics": true,
        "completions": true,
        "documentFormatting": true,
        "hover": true
      }
    },
    "css": {
      "command": ["node_modules/.bin/vscode-css-language-server", "--stdio"],
      "extensions": [".css"],
      "initialization": {
        "diagnostics": true,
        "completions": true,
        "documentFormatting": true,
        "hover": true
      }
    }
  },

  "plugin": [],

  "formatter": {
    "prettier": {
      "command": ["node_modules/.bin/prettier", "--stdin-filepath", "$FILENAME"],
      "extensions": [".ts", ".tsx", ".json", ".css"]
    }
  }
}
