{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "default_agent": "build",
  "subagent_depth": 1,
  "instructions": [
    "AGENTS.md",
    "docs/agents/opencode-instructions.md",
    ".memory/patrones.md",
    ".memory/sesion-actual.md"
  ],
  "skills": {
    "paths": ["./skills"]
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "api/index.js",
      ".git/**",
      ".opencode/node_modules/**",
      "enhanced-video/**",
      "reportes/**"
    ]
  },
  "mcp": {
    "gortex": {
      "type": "local",
      "command": [
        "C:\\Users\\heae2\\AppData\\Local\\Programs\\gortex\\gortex.exe",
        "mcp"
      ],
      "enabled": true,
      "environment": {
        "GORTEX_INDEX_WORKERS": "2"
      }
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": true
    },
    "contexto-docs": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{env:CONTEXT7_API_KEY}"
      ],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  },
  "agent": {
    "arquitectura": {
      "description": "Disena modulos, arquitectura y decisiones tecnicas del proyecto antes de implementar.",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-5",
      "prompt": "Responde siempre en espanol (es-CL). Disena para React 19, Vite, Supabase, Express, zod, TanStack Query y Zustand. Entrega decision breve, componentes, riesgos y proximos pasos. Si la tarea pide codigo, deriva a implementacion.",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "implementacion": {
      "description": "Implementa cambios de codigo con tipos, tests y verificacion.",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-5",
      "prompt": "Responde siempre en espanol (es-CL). Implementa cambios minimos en TypeScript/React/Supabase, respeta multitenant, usa zod cuando corresponda y verifica con lint/typecheck/tests proporcionales.",
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    },
    "memoria": {
      "description": "Resume decisiones reutilizables y mantiene la memoria local breve.",
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5",
      "prompt": "Responde siempre en espanol (es-CL). Lee .memory/patrones.md antes de guardar, no guardes secretos ni PII, y registra solo decisiones reutilizables en maximo cinco lineas.",
      "permission": {
        "edit": "ask",
        "bash": "deny"
      }
    }
  },
  "plugin": ["@dietrichgebert/ponytail"],
  "tool_output": {
    "max_lines": 1200,
    "max_bytes": 60000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  }
}
