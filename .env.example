# === Servidor ===
PORT=3001
APP_URL=http://localhost:3000
NODE_ENV=development

# === CORS ===
# Orígenes permitidos separados por coma. Vacío = sin CORS (solo same-origin).
# Ejemplo: https://app.ejemplo.cl,https://otra-app.vercel.app
ALLOWED_ORIGINS=

# === AI APIs (servidor / Vercel) ===
GEMINI_API_KEY=your_gemini_api_key
LEGAL_DRAFT_MODEL=gemini-3.6-flash
TEXT_IMPROVEMENT_GEMINI_MODEL=gemini-3.6-flash
TEXT_IMPROVEMENT_PROVIDER=gemini
# OpenRouter queda como respaldo de mejora de textos y asesoría breve.
OPENROUTER_API_KEY=your_openrouter_api_key
TEXT_IMPROVEMENT_AI_MODEL=google/gemma-4-31b-it:free
TEXT_AI_MODEL=

# === Supabase ===
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Clave de sesión exclusiva de esta aplicación; debe ser distinta en otras apps compartidas.
VITE_SUPABASE_AUTH_STORAGE_KEY=convivencia-auth-token
# Compatibilidad heredada solamente:
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Solo para proyectos heredados que todavía firman JWT con HS256.
# Los proyectos con claves asimétricas se verifican automáticamente mediante JWKS.
SUPABASE_JWT_SECRET=

# Service role key (solo para operaciones privilegiadas desde servidor)
# NO exponer en frontend. Se obtiene en Supabase Dashboard > Settings > API
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DEFAULT_TENANT_ID=your_default_tenant_uuid

# Demo local sin login (solo desarrollo). En producción dejar en false o omitir.
VITE_ALLOW_LOCAL_DEMO=false

# === Sentry (Error Tracking) ===
# Obtener en https://sentry.io/settings/projects/
VITE_SENTRY_DSN=https://your-project@sentry.io/123456

# === PostHog (Analytics) ===
# Obtener en https://app.posthog.com/project/settings
VITE_POSTHOG_KEY=phc_your_project_key
VITE_POSTHOG_HOST=https://app.posthog.com

# === Rate Limiting Persistente (opcional, para producción en Vercel) ===
# Si no está configurado, se usa rate limit en memoria (inútil en serverless).
# Obtener en https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === E2E (Playwright) ===
# URL base contra la que corren los tests. Por defecto usa el servidor dev
# local (http://localhost:3001). Playwright levanta `npm run dev` si el
# servidor no está corriendo (reuseExistingServer: true).
E2E_BASE_URL=http://localhost:3001
# Credenciales de un usuario staff real del tenant de pruebas. Sin ellas,
# los specs de login se omiten (patrón usado en tests/case-flow.spec.ts).
E2E_STAFF_EMAIL=usuario@colegio.cl
E2E_STAFF_PASSWORD=
# Credenciales opcionales de superadmin para el spec de plataforma
# (tests/platform.spec.ts). Sin ellas, ese spec se omite.
E2E_SUPERADMIN_EMAIL=
E2E_SUPERADMIN_PASSWORD=
# Credenciales opcionales de una cuenta sin membresía activa en la aplicación
# convivencia (para el spec de enforced mode en tests/smoke-membership.spec.ts).
# Debe existir en la base de datos sin filas activas en app_memberships.
E2E_NO_MEMBERSHIP_EMAIL=e2e-sin-membresia@colegio.cl
E2E_NO_MEMBERSHIP_PASSWORD=
VITE_NOTIFICATIONS_REALTIME=false
